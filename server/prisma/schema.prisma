generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(AGENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  assignedProducts Product[] @relation("ProductAssignedAgent")
  assignedInquiries Inquiry[] @relation("InquiryAssignedAgent")
  authoredMessages  Message[] @relation("MessageAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Customer-facing accounts — a second, fully separate Better Auth instance
// (server/src/lib/customer-auth.ts) from the staff User/Session/Account/
// Verification tables above. Kept separate rather than adding a third Role
// value: the staff instance has public signup deliberately disabled and
// `role` is a staff-only, exhaustively ADMIN|AGENT concept elsewhere in the
// codebase (requireRole, agent-assignment dropdowns, etc.) — reusing it would
// mean either weakening that signup gate or bolting an unrelated concept onto
// every place that treats Role as exhaustive. No deletedAt/soft-delete here:
// there's no account-deactivation flow being built, so it would be
// speculative — add it if/when that flow exists.
model Customer {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  mobile        String?   @db.VarChar(20)
  gender        Gender?
  region        String?   @db.VarChar(100)
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      CustomerSession[]
  accounts      CustomerAccount[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@unique([email])
  @@map("customer")
}

model CustomerSession {
  id         String   @id
  expiresAt  DateTime
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ipAddress  String?
  userAgent  String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([customerId])
  @@map("customer_session")
}

model CustomerAccount {
  id                    String    @id
  accountId             String
  providerId            String
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerId])
  @@map("customer_account")
}

model CustomerVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("customer_verification")
}

model Category {
  id        String    @id
  name      Json
  imageUrl  String?
  homeRow   String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  products  Product[]

  @@map("category")
}

model Product {
  id                String    @id
  name              Json
  description       Json?
  price             Int
  // Nullable discounted price — null means "not on sale". When set, the
  // storefront shows this as the current price with `price` struck through
  // beside it as the original. Same whole-number-Int convention as `price`
  // (no cents), and deliberately not validated at the DB layer to be lower
  // than `price` — the zod schema (core/src/schemas/product.ts) enforces
  // that on write, matching how other cross-field invariants in this
  // codebase (e.g. PromoBlock's ctaLabel/ctaUrl pair) are schema-level, not
  // DB-constraint-level, checks.
  salePrice         Int?
  stock             Int
  lowStockThreshold Int       @default(10)
  // Ordered list of "/api/uploads/products/<file>" URLs — first is the
  // primary/thumbnail image. Plain array rather than a relation table,
  // matching tags/aiSuggestedTags below (fine at this catalog's scale,
  // capped at MAX_PRODUCT_IMAGES in core/src/schemas/product.ts).
  images            String[]  @default([])
  tags              String[]  @default([])
  // Free-text variant-distinguishing labels shown on the storefront and in
  // the admin variant-linking UI — not enums (matches the low-effort style
  // of tags/category naming elsewhere), not a nested attribute table (this
  // codebase's variant model is "separate Product rows sharing
  // variantGroupId", not per-SKU attributes on one row). Independent of each
  // other: a product can have a size, a color, both, or neither.
  size              String?   @db.VarChar(50)
  color             String?   @db.VarChar(50)
  // Groups products that are "the same item, different variant" (e.g. color)
  // so the storefront PDP can cross-link them. Server-generated (randomUUID)
  // the first time a product is linked to another — never client-supplied.
  // Symmetric by construction (a plain shared token, not a directional
  // relation), so no bidirectional-sync bookkeeping is needed.
  variantGroupId    String?
  // Populated by the bulk "reclassify all products" pg-boss job — a pending
  // suggestion for staff to accept/dismiss, never auto-applied. Unrelated to
  // the synchronous single-product "Suggest with AI" flow in the create/edit
  // form, which is ephemeral and doesn't touch these fields.
  aiSuggestedCategoryId String?
  aiSuggestedTags       String[]  @default([])
  aiSuggestedAt         DateTime?
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  assignedAgentId   String?
  assignedAgent     User?     @relation("ProductAssignedAgent", fields: [assignedAgentId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  orderItems        OrderItem[]
  concernedInquiries Inquiry[] @relation("InquiryConcernedProduct")
  reviews           Review[]
  wishlistItems     WishlistItem[]

  @@index([categoryId])
  @@index([assignedAgentId])
  @@index([variantGroupId])
  @@map("product")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("setting")
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum CancelReason {
  CUSTOMER_UNREACHABLE
  OUTSIDE_DELIVERY_AREA
  CUSTOMER_REQUEST
  OTHER
}

model Order {
  id              String          @id
  code            String          @unique
  status          OrderStatus     @default(RECEIVED)
  fulfillmentType FulfillmentType
  customerName    String
  customerPhone   String
  address         String?
  deliveryFee     Int             @default(0)
  cancelReason    CancelReason?
  callAttempts    Int             @default(0)
  // Nullable: set only when the order was placed while signed in to a
  // customer account (soft/optional auth in POST /storefront/orders — the
  // route stays public either way). customerName/customerPhone/address stay
  // as point-in-time snapshots regardless, same as OrderItem's
  // productName/unitPrice snapshot pattern.
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           OrderItem[]
  smsLogs         SmsLog[]

  @@index([customerId])
  @@map("order")
}

model OrderItem {
  id          String  @id
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName Json
  unitPrice   Int
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

enum InquiryChannel {
  WEBSITE
}

enum InquiryStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MessageSender {
  CUSTOMER
  STAFF
  AI_DRAFT
}

model Inquiry {
  id              String         @id
  // Non-enumerable short code (same alphabet/length as Order.code) letting a
  // guest look up this thread later by code + email, without relying on the
  // localStorage-persisted id the chat widget uses.
  code            String         @unique
  channel         InquiryChannel @default(WEBSITE)
  status          InquiryStatus  @default(OPEN)
  customerName    String
  // Nullable — the contact form now requires a phone but only optionally
  // collects email (this market treats a callable number as more reliable
  // than an email address). Older rows and every guest lookup by email
  // still work; a guest who didn't give an email just can't use that
  // lookup path (see inquiryLookupSchema below), a known, accepted gap.
  customerEmail   String?
  customerPhone   String?
  // Customer-picked topic from the storefront contact form's "What's this
  // about?" select (core's INQUIRY_TOPICS) — plain string, not a Prisma
  // enum, same precedent as `language`/`aiTopic` below. Nullable since
  // inquiries created before this field existed have no value, and the
  // guest follow-up route (addMessageSchema) never sets it.
  topic           String?
  // Bare code from core's LANGUAGES ("en"/"ar"/"sw"/"fr") — the customer's UI
  // language at submission time, not a Prisma enum (matches how LocalizedName
  // treats language as plain string keys rather than DB-enum-backed).
  language        String         @default("en")
  assignedAgentId String?
  assignedAgent   User?          @relation("InquiryAssignedAgent", fields: [assignedAgentId], references: [id])
  // Null = never escalated. Orthogonal to `status` — an inquiry can be OPEN
  // (or RESOLVED) and escalated at the same time; escalation doesn't replace
  // the OPEN/RESOLVED/CLOSED lifecycle.
  escalatedAt     DateTime?
  // AI classification (Phase 6.4) — all nullable, populated fire-and-forget
  // after inquiry creation. aiTopic/aiUrgency are plain strings (not Prisma
  // enums), matching the `language` precedent. aiProductId mirrors
  // assignedAgentId's nullable-FK pattern; "auto-routing to queues" means the
  // classifier sets assignedAgentId to the concerned product's agent rather
  // than introducing a new queue concept.
  aiTopic         String?
  aiUrgency       String?
  aiConfidence    Float?
  aiProductId     String?
  aiProduct       Product?       @relation("InquiryConcernedProduct", fields: [aiProductId], references: [id])
  // Set when applyAutoResolve (server/src/lib/inquiry-auto-resolve.ts) sends
  // a reply automatically from the static knowledge-base.md doc, with no
  // staff review — orthogonal to `status` the same way escalatedAt is,
  // though in practice it's only ever set alongside status: RESOLVED.
  // Indexed because GET /inquiries and /inquiries/attention-count both
  // filter on it, unlike escalatedAt which isn't a list filter.
  autoResolvedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        Message[]
  smsLogs         SmsLog[]

  @@index([assignedAgentId])
  @@index([status])
  @@index([status, assignedAgentId])
  @@index([aiProductId])
  @@index([autoResolvedAt])
  @@map("inquiry")
}

model Message {
  id           String        @id
  inquiryId    String
  inquiry      Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender       MessageSender
  authorUserId String?
  author       User?         @relation("MessageAuthor", fields: [authorUserId], references: [id])
  body         String
  // Ids of KB articles that informed an AI_DRAFT reply (empty otherwise) —
  // a plain string list, not a relation, mirroring OrderItem's productName
  // snapshot: historical context for 6.7's "view draft with sources" UI, not
  // something needing referential integrity against articles that may later
  // change or be deleted.
  sourceKbArticleIds String[]    @default([])
  // Meaningful only on AI_DRAFT rows: PENDING until an agent reviews it, then
  // SENT_UNEDITED/SENT_EDITED (a new STAFF message is minted, this row stays
  // immutable history) or DISCARDED (no reply sent). Null for CUSTOMER/STAFF.
  draftStatus  DraftStatus?
  // Set only on the STAFF message minted by approving an AI_DRAFT (see the
  // approve route) — links back to the original draft so metrics can compare
  // the sent text against what the model proposed (e.g. edit-amount rate).
  // SetNull rather than Cascade/Restrict: this is informational metadata, not
  // integrity-critical, and shouldn't block or ripple from the draft row's
  // own lifecycle.
  sourceDraftMessageId String?
  sourceDraftMessage   Message?  @relation("MessageDraftSource", fields: [sourceDraftMessageId], references: [id], onDelete: SetNull)
  draftApprovals       Message[] @relation("MessageDraftSource")
  createdAt    DateTime      @default(now())

  @@index([inquiryId])
  @@map("message")
}

enum DraftStatus {
  PENDING
  SENT_UNEDITED
  SENT_EDITED
  DISCARDED
  AUTO_RESOLVED
}

model KbArticle {
  id        String    @id
  title     Json
  body      Json
  topic     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Generated tsvector columns (title + body per language, weighted A/B) — see
  // migration 20260721_kb_article_search. Prisma can't read/write Unsupported
  // fields; declaring them here just stops future migrations from treating
  // them as drift and proposing a DROP COLUMN.
  searchEn Unsupported("tsvector")? @map("search_en")
  searchAr Unsupported("tsvector")? @map("search_ar")
  searchSw Unsupported("tsvector")? @map("search_sw")
  searchFr Unsupported("tsvector")? @map("search_fr")

  @@index([topic])
  @@map("kb_article")
}

// Short promotional content block (headline, optional copy, optional CTA
// button) shown on the storefront homepage. isActive hides a block from the
// storefront without deleting it — a separate concern from deletedAt, same
// precedent as Inquiry.escalatedAt being orthogonal to status. sortOrder is a
// plain admin-set integer (ascending) rather than drag-and-drop, since no
// such UI/lib exists elsewhere in this codebase. startsAt/endsAt are a third,
// independent visibility gate on top of isActive — a block only reaches the
// storefront when it's active AND (unset or) inside its scheduled window, so
// staff can queue up a promo ahead of time or let one expire on its own
// without having to remember to flip isActive manually.
model PromoBlock {
  id        String    @id
  headline  Json
  copy      Json?
  ctaLabel  String?
  ctaUrl    String?
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@map("promo_block")
}

// Customer product review, submitted from the storefront product detail page.
// Guest-first like Order: authorName is a point-in-time free-text field, and
// customerId is soft-attached (nullable) only when a customer-session cookie
// happened to be present at submission — same optional-auth pattern as
// Order.customerId. No deletedAt: reviews are never soft-deleted (there's no
// moderation flow in v1 — add one if/when that exists).
model Review {
  id         String    @id
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  authorName String
  rating     Int
  // Optional short summary shown above the review body (e.g. "Great value
  // for the price") — plain text, no length enforced at the DB layer (same
  // as `comment`), validated by the zod schema (core/src/schemas/review.ts).
  headline   String?
  comment    String?
  // Snapshot taken at creation (like OrderItem.productName): true when the
  // soft-attached customer had a non-cancelled order containing this product
  // at the time of review — not recomputed if orders change later.
  verifiedPurchase Boolean @default(false)
  // Public staff response to a review, shown on the storefront under the
  // customer's own text. Plain text fields (no attribution FK, like
  // KbArticle's lack of a createdBy) — this is a single visible reply, not a
  // thread. staffReplyAt null means no reply yet; clearing a reply (retract)
  // nulls both together.
  staffReply   String?
  staffReplyAt DateTime?
  createdAt  DateTime  @default(now())

  // Postgres treats NULLs as distinct in unique indexes, so this blocks a
  // signed-in customer from reviewing the same product twice while leaving
  // guest reviews (customerId NULL) unlimited. Also serves customerId lookups
  // (replaces the earlier plain @@index([customerId])).
  @@unique([customerId, productId])
  @@index([productId])
  @@map("review")
}

// Signed-in customer's saved-for-later products. Account-only by design (no
// guest/localStorage tier) — customerId is required with onDelete: Cascade,
// the "hard ownership" pattern CustomerSession/CustomerAccount use, not the
// nullable soft-attach pattern Order/Review use, since a wishlist has no
// meaning without an account.
model WishlistItem {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
  // Snapshot taken once at save time (like OrderItem.unitPrice) — never
  // recomputed on subsequent stock changes. Powers an in-app "back in stock"
  // signal: `wasOutOfStockAtSave && product.stock > 0` at read time. This
  // store has no email/push infrastructure anywhere (see the "No email
  // flows" note), so "notify me" here means a visible badge on
  // /account/wishlist and the header, not an actual notification — a
  // deliberately scoped-down interpretation of the feature, not a stand-in
  // for one. Doesn't track re-transitions (out of stock again, then back
  // again) or a "seen/dismissed" state — a known v1 simplification.
  wasOutOfStockAtSave Boolean @default(false)
  // Same snapshot-at-save-time idea, applied to price instead of stock —
  // powers a "price dropped" signal (`priceAtSave !== null && product.price
  // < priceAtSave` at read time). Nullable (not defaulted like
  // wasOutOfStockAtSave) rather than backfilled: a row from before this
  // column existed simply has nothing to compare against, so it's "not
  // tracked" rather than a confusing 0/free-price sentinel.
  priceAtSave Int?

  // Mirrors Review's @@unique([customerId, productId]) — prevents duplicate
  // wishlisting and lets the add route be a simple upsert.
  @@unique([customerId, productId])
  @@index([productId])
  @@map("wishlist_item")
}

// Singleton row (fixed id) of lightweight counters for the product
// classification (7.1-7.3) acceptance-rate dashboard stat — a lower-fidelity
// alternative to logging every individual suggestion, since there's no
// natural per-suggestion entity to attach an outcome to the way Message
// carries draftStatus for inquiry drafts.
model ProductClassificationMetric {
  id                String @id @default("singleton")
  categorySuggested Int    @default(0)
  categoryAccepted  Int    @default(0)
  tagsSuggested     Int    @default(0)
  tagsAccepted      Int    @default(0)

  @@map("product_classification_metric")
}

model ProductStockSnapshot {
  id                String   @id @default(cuid())
  date              DateTime @unique @db.Date
  soldOutCount      Int
  soldOutProductIds String[] @default([])

  @@map("product_stock_snapshot")
}

// Singleton row guarding against two "reclassify all" batches running
// concurrently — see acquireReclassifyLock in product-reclassify-lock.ts.
// TTL-based (expiresAt), not completion-triggered, so it self-heals if a
// batch crashes without a clean release.
model ProductReclassifyBatch {
  id        String   @id @default("singleton")
  startedAt DateTime
  expiresAt DateTime

  @@map("product_reclassify_batch")
}

// SKIPPED means credentials weren't configured (server/src/lib/sms.ts's
// no-op path) — a deliberate third state, distinct from FAILED, so staff
// can tell "nothing was even attempted" apart from "attempted and errored".
enum SmsLogStatus {
  SENT
  FAILED
  SKIPPED
}

// One row per sendSms() call (server/src/lib/sms.ts), regardless of
// outcome — gives staff visibility into whether a customer was actually
// notified, since every status-transition/reply SMS is fire-and-forget
// from the caller's perspective. orderId/inquiryId are both nullable and
// mutually-not-exclusive-by-schema (exactly one is set in practice, per
// which of the 6 templates fired) rather than a polymorphic single column,
// matching this codebase's existing precedent of plain nullable FKs over
// a discriminated-union column (e.g. Inquiry.aiProductId).
model SmsLog {
  id        String        @id
  to        String
  message   String
  status    SmsLogStatus
  error     String?
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inquiryId String?
  inquiry   Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([inquiryId])
  @@map("sms_log")
}
