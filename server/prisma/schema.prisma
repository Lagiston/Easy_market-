generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum Locale {
  EN
  AR
  SW
  FR
}

enum OrderStatus {
  PLACED
  CONFIRMED
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum InquiryChannel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum InquiryStatus {
  NEW
  AI_DRAFTED
  ESCALATED
  SENT
  CLOSED
}

enum InquiryTopic {
  ORDER_STATUS
  PRODUCT_QUESTION
  PRICE_STOCK
  COMPLAINT
  REFUND
  DELIVERY
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  AI_DRAFT
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role      @default(AGENT)
  mustChangePassword Boolean   @default(false)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  sessions           Session[]
  inquiryMessages    InquiryMessage[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  createdAt    DateTime              @default(now())
  translations CategoryTranslation[]
  products     Product[]
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     Locale
  name       String

  @@unique([categoryId, locale])
}

model Product {
  id                String               @id @default(cuid())
  sku               String               @unique
  price             Decimal              @db.Decimal(12, 2)
  stock             Int                  @default(0)
  lowStockThreshold Int                  @default(5)
  images            String[]
  tags              String[]
  isActive          Boolean              @default(true)
  categoryId        String?
  category          Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  translations      ProductTranslation[]
  orderItems        OrderItem[]
  inquiries         Inquiry[]

  @@index([categoryId])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String  @default("")

  @@unique([productId, locale])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  status       OrderStatus @default(PLACED)
  fulfillment  Fulfillment
  customerName String
  phone        String
  email        String?
  address      String?
  locale       Locale      @default(EN)
  total        Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([phone])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model Inquiry {
  id               String           @id @default(cuid())
  channel          InquiryChannel   @default(WEBSITE)
  status           InquiryStatus    @default(NEW)
  customerName     String
  email            String
  locale           Locale           @default(EN)
  topic            InquiryTopic?
  urgency          Int?
  confidence       Float?
  relatedProductId String?
  relatedProduct   Product?         @relation(fields: [relatedProductId], references: [id], onDelete: SetNull)
  accessToken      String           @unique @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  messages         InquiryMessage[]

  @@index([status])
}

model InquiryMessage {
  id           String           @id @default(cuid())
  inquiryId    String
  inquiry      Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  direction    MessageDirection
  body         String
  authorUserId String?
  author       User?            @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([inquiryId])
}

model KbArticle {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  topics       InquiryTopic[]
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations KbArticleTranslation[]
}

model KbArticleTranslation {
  id        String    @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale    Locale
  title     String
  body      String

  @@unique([articleId, locale])
}
