generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(AGENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  assignedProducts Product[] @relation("ProductAssignedAgent")
  assignedInquiries Inquiry[] @relation("InquiryAssignedAgent")
  authoredMessages  Message[] @relation("MessageAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id        String    @id
  name      Json
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  products  Product[]

  @@map("category")
}

model Product {
  id                String    @id
  name              Json
  description       Json?
  price             Int
  stock             Int
  lowStockThreshold Int       @default(10)
  imageUrl          String?
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  assignedAgentId   String?
  assignedAgent     User?     @relation("ProductAssignedAgent", fields: [assignedAgentId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([assignedAgentId])
  @@map("product")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("setting")
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum CancelReason {
  CUSTOMER_UNREACHABLE
  OUTSIDE_DELIVERY_AREA
  CUSTOMER_REQUEST
  OTHER
}

model Order {
  id              String          @id
  code            String          @unique
  status          OrderStatus     @default(RECEIVED)
  fulfillmentType FulfillmentType
  customerName    String
  customerPhone   String
  address         String?
  deliveryFee     Int             @default(0)
  cancelReason    CancelReason?
  callAttempts    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           OrderItem[]

  @@map("order")
}

model OrderItem {
  id          String  @id
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName Json
  unitPrice   Int
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

enum InquiryChannel {
  WEBSITE
}

enum InquiryStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MessageSender {
  CUSTOMER
  STAFF
}

model Inquiry {
  id              String         @id
  channel         InquiryChannel @default(WEBSITE)
  status          InquiryStatus  @default(OPEN)
  customerName    String
  customerEmail   String
  customerPhone   String?
  // Bare code from core's LANGUAGES ("en"/"ar"/"sw"/"fr") — the customer's UI
  // language at submission time, not a Prisma enum (matches how LocalizedName
  // treats language as plain string keys rather than DB-enum-backed).
  language        String         @default("en")
  assignedAgentId String?
  assignedAgent   User?          @relation("InquiryAssignedAgent", fields: [assignedAgentId], references: [id])
  // Null = never escalated. Orthogonal to `status` — an inquiry can be OPEN
  // (or RESOLVED) and escalated at the same time; escalation doesn't replace
  // the OPEN/RESOLVED/CLOSED lifecycle.
  escalatedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        Message[]

  @@index([assignedAgentId])
  @@index([status])
  @@index([status, assignedAgentId])
  @@map("inquiry")
}

model Message {
  id           String        @id
  inquiryId    String
  inquiry      Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender       MessageSender
  authorUserId String?
  author       User?         @relation("MessageAuthor", fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime      @default(now())

  @@index([inquiryId])
  @@map("message")
}

model KbArticle {
  id        String    @id
  title     Json
  body      Json
  topic     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([topic])
  @@map("kb_article")
}
