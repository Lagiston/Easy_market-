generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(AGENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  assignedProducts Product[] @relation("ProductAssignedAgent")
  assignedInquiries Inquiry[] @relation("InquiryAssignedAgent")
  authoredMessages  Message[] @relation("MessageAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Customer-facing accounts — a second, fully separate Better Auth instance
// (server/src/lib/customer-auth.ts) from the staff User/Session/Account/
// Verification tables above. Kept separate rather than adding a third Role
// value: the staff instance has public signup deliberately disabled and
// `role` is a staff-only, exhaustively ADMIN|AGENT concept elsewhere in the
// codebase (requireRole, agent-assignment dropdowns, etc.) — reusing it would
// mean either weakening that signup gate or bolting an unrelated concept onto
// every place that treats Role as exhaustive. No deletedAt/soft-delete here:
// there's no account-deactivation flow being built, so it would be
// speculative — add it if/when that flow exists.
model Customer {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      CustomerSession[]
  accounts      CustomerAccount[]
  orders        Order[]

  @@unique([email])
  @@map("customer")
}

model CustomerSession {
  id         String   @id
  expiresAt  DateTime
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ipAddress  String?
  userAgent  String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([customerId])
  @@map("customer_session")
}

model CustomerAccount {
  id                    String    @id
  accountId             String
  providerId            String
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerId])
  @@map("customer_account")
}

model CustomerVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("customer_verification")
}

model Category {
  id        String    @id
  name      Json
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  products  Product[]

  @@map("category")
}

model Product {
  id                String    @id
  name              Json
  description       Json?
  price             Int
  stock             Int
  lowStockThreshold Int       @default(10)
  // Ordered list of "/api/uploads/products/<file>" URLs — first is the
  // primary/thumbnail image. Plain array rather than a relation table,
  // matching tags/aiSuggestedTags below (fine at this catalog's scale,
  // capped at MAX_PRODUCT_IMAGES in core/src/schemas/product.ts).
  images            String[]  @default([])
  tags              String[]  @default([])
  // Groups products that are "the same item, different variant" (e.g. color)
  // so the storefront PDP can cross-link them. Server-generated (randomUUID)
  // the first time a product is linked to another — never client-supplied.
  // Symmetric by construction (a plain shared token, not a directional
  // relation), so no bidirectional-sync bookkeeping is needed.
  variantGroupId    String?
  // Populated by the bulk "reclassify all products" pg-boss job — a pending
  // suggestion for staff to accept/dismiss, never auto-applied. Unrelated to
  // the synchronous single-product "Suggest with AI" flow in the create/edit
  // form, which is ephemeral and doesn't touch these fields.
  aiSuggestedCategoryId String?
  aiSuggestedTags       String[]  @default([])
  aiSuggestedAt         DateTime?
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  assignedAgentId   String?
  assignedAgent     User?     @relation("ProductAssignedAgent", fields: [assignedAgentId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  orderItems        OrderItem[]
  concernedInquiries Inquiry[] @relation("InquiryConcernedProduct")

  @@index([categoryId])
  @@index([assignedAgentId])
  @@index([variantGroupId])
  @@map("product")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("setting")
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum CancelReason {
  CUSTOMER_UNREACHABLE
  OUTSIDE_DELIVERY_AREA
  CUSTOMER_REQUEST
  OTHER
}

model Order {
  id              String          @id
  code            String          @unique
  status          OrderStatus     @default(RECEIVED)
  fulfillmentType FulfillmentType
  customerName    String
  customerPhone   String
  address         String?
  deliveryFee     Int             @default(0)
  cancelReason    CancelReason?
  callAttempts    Int             @default(0)
  // Nullable: set only when the order was placed while signed in to a
  // customer account (soft/optional auth in POST /storefront/orders — the
  // route stays public either way). customerName/customerPhone/address stay
  // as point-in-time snapshots regardless, same as OrderItem's
  // productName/unitPrice snapshot pattern.
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           OrderItem[]

  @@index([customerId])
  @@map("order")
}

model OrderItem {
  id          String  @id
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName Json
  unitPrice   Int
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

enum InquiryChannel {
  WEBSITE
}

enum InquiryStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MessageSender {
  CUSTOMER
  STAFF
  AI_DRAFT
}

model Inquiry {
  id              String         @id
  channel         InquiryChannel @default(WEBSITE)
  status          InquiryStatus  @default(OPEN)
  customerName    String
  customerEmail   String
  customerPhone   String?
  // Bare code from core's LANGUAGES ("en"/"ar"/"sw"/"fr") — the customer's UI
  // language at submission time, not a Prisma enum (matches how LocalizedName
  // treats language as plain string keys rather than DB-enum-backed).
  language        String         @default("en")
  assignedAgentId String?
  assignedAgent   User?          @relation("InquiryAssignedAgent", fields: [assignedAgentId], references: [id])
  // Null = never escalated. Orthogonal to `status` — an inquiry can be OPEN
  // (or RESOLVED) and escalated at the same time; escalation doesn't replace
  // the OPEN/RESOLVED/CLOSED lifecycle.
  escalatedAt     DateTime?
  // AI classification (Phase 6.4) — all nullable, populated fire-and-forget
  // after inquiry creation. aiTopic/aiUrgency are plain strings (not Prisma
  // enums), matching the `language` precedent. aiProductId mirrors
  // assignedAgentId's nullable-FK pattern; "auto-routing to queues" means the
  // classifier sets assignedAgentId to the concerned product's agent rather
  // than introducing a new queue concept.
  aiTopic         String?
  aiUrgency       String?
  aiConfidence    Float?
  aiProductId     String?
  aiProduct       Product?       @relation("InquiryConcernedProduct", fields: [aiProductId], references: [id])
  // Set when applyAutoResolve (server/src/lib/inquiry-auto-resolve.ts) sends
  // a reply automatically from the static knowledge-base.md doc, with no
  // staff review — orthogonal to `status` the same way escalatedAt is,
  // though in practice it's only ever set alongside status: RESOLVED.
  // Indexed because GET /inquiries and /inquiries/attention-count both
  // filter on it, unlike escalatedAt which isn't a list filter.
  autoResolvedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        Message[]

  @@index([assignedAgentId])
  @@index([status])
  @@index([status, assignedAgentId])
  @@index([aiProductId])
  @@index([autoResolvedAt])
  @@map("inquiry")
}

model Message {
  id           String        @id
  inquiryId    String
  inquiry      Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender       MessageSender
  authorUserId String?
  author       User?         @relation("MessageAuthor", fields: [authorUserId], references: [id])
  body         String
  // Ids of KB articles that informed an AI_DRAFT reply (empty otherwise) —
  // a plain string list, not a relation, mirroring OrderItem's productName
  // snapshot: historical context for 6.7's "view draft with sources" UI, not
  // something needing referential integrity against articles that may later
  // change or be deleted.
  sourceKbArticleIds String[]    @default([])
  // Meaningful only on AI_DRAFT rows: PENDING until an agent reviews it, then
  // SENT_UNEDITED/SENT_EDITED (a new STAFF message is minted, this row stays
  // immutable history) or DISCARDED (no reply sent). Null for CUSTOMER/STAFF.
  draftStatus  DraftStatus?
  createdAt    DateTime      @default(now())

  @@index([inquiryId])
  @@map("message")
}

enum DraftStatus {
  PENDING
  SENT_UNEDITED
  SENT_EDITED
  DISCARDED
  AUTO_RESOLVED
}

model KbArticle {
  id        String    @id
  title     Json
  body      Json
  topic     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Generated tsvector columns (title + body per language, weighted A/B) — see
  // migration 20260721_kb_article_search. Prisma can't read/write Unsupported
  // fields; declaring them here just stops future migrations from treating
  // them as drift and proposing a DROP COLUMN.
  searchEn Unsupported("tsvector")? @map("search_en")
  searchAr Unsupported("tsvector")? @map("search_ar")
  searchSw Unsupported("tsvector")? @map("search_sw")
  searchFr Unsupported("tsvector")? @map("search_fr")

  @@index([topic])
  @@map("kb_article")
}

// Singleton row (fixed id) of lightweight counters for the product
// classification (7.1-7.3) acceptance-rate dashboard stat — a lower-fidelity
// alternative to logging every individual suggestion, since there's no
// natural per-suggestion entity to attach an outcome to the way Message
// carries draftStatus for inquiry drafts.
model ProductClassificationMetric {
  id                String @id @default("singleton")
  categorySuggested Int    @default(0)
  categoryAccepted  Int    @default(0)
  tagsSuggested     Int    @default(0)
  tagsAccepted      Int    @default(0)

  @@map("product_classification_metric")
}

model ProductStockSnapshot {
  id                String   @id @default(cuid())
  date              DateTime @unique @db.Date
  soldOutCount      Int
  soldOutProductIds String[] @default([])

  @@map("product_stock_snapshot")
}

// Singleton row guarding against two "reclassify all" batches running
// concurrently — see acquireReclassifyLock in product-reclassify-lock.ts.
// TTL-based (expiresAt), not completion-triggered, so it self-heals if a
// batch crashes without a clean release.
model ProductReclassifyBatch {
  id        String   @id @default("singleton")
  startedAt DateTime
  expiresAt DateTime

  @@map("product_reclassify_batch")
}
