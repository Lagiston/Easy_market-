DATABASE_URL="postgresql://user@localhost:5432/es_market"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
CLIENT_URL="http://localhost:5173"
OPENAI_API_KEY="sk-..."

# Cloudinary — required, the sole image storage backend for product images,
# category cover images, and customer avatars (server/src/lib/cloudinary.ts).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Optional. Only active when NODE_ENV=production. Leave blank to disable
# server-side Sentry error tracking (e.g. in local dev).
SENTRY_DSN=""

# Optional. Only set this once a real reverse proxy/load balancer sits in
# front of this server — it tells Express how many proxy hops to trust for
# X-Forwarded-For (usually 1). Leave unset when the server is exposed
# directly (e.g. a bare VPS with no nginx/Caddy in front), otherwise clients
# could spoof their IP and bypass per-IP rate limiting.
TRUST_PROXY_HOPS=""

# Optional. Leave both blank to disable outbound transactional SMS (order
# confirmed/out-for-delivery/delivered/delayed, inquiry-reply notifications)
# — server/src/lib/sms.ts logs a startup warning and every send becomes a
# no-op until both are set.
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
# Optional. Africa's Talking sender ID / short code; omit to use the
# account's default sender.
AFRICASTALKING_SENDER_ID=""
